# Required
AUTH_SECRET=
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=vector

# Real-time on Vercel (leave unset locally to use Server-Sent Events)
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# Image uploads on Vercel (set automatically when a Blob store is connected)
BLOB_READ_WRITE_TOKEN=

# Vercel Cron for /api/cron/wakes (push wake-up retries) and /api/cron/wait-reminders; unset = routes off. Not needed locally.
CRON_SECRET=

# Email (src/lib/email.ts). Transport: "ses" (Amazon SES v2) or "log" (print to the server log, never sends).
# Unset = ses when all five SES values below are set; otherwise log in local dev, and an error at send time in
# production (set EMAIL_TRANSPORT=log there to run without email on purpose). The SES_* names are the app's own so
# they don't collide with other AWS credentials on Vercel. Use the scoped IAM user and configuration set for the
# environment (aimpoint-prod / aimpoint-dev): SES_CONFIGURATION_SET is always sent and carries bounce/complaint events.
EMAIL_TRANSPORT=
EMAIL_FROM=Aimpoint <noreply@aimpoint.dev>
SES_REGION=us-east-1
SES_CONFIGURATION_SET=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# Optional: send every email to this one address instead (the subject and body name the original recipients).
# For the dev deployment, so test data never mails real people.
EMAIL_DEV_REDIRECT=

# Billing for managed hosting (Stripe). Paid only, no free tier and no trial: Pro is US$4.95 per user/month
# (tax added on top), billed per organisation with the number of people (members; bots and pending invites
# don't count) as the subscription quantity, prorated as people join or leave. An org without a live
# subscription (or past due beyond 7 days) is locked, not deleted, until an admin subscribes. STRIPE_PRICE_ID is a recurring per-unit price of US$4.95/month. Unset or false = self-hosted:
# billing off, every feature unlocked, no Stripe needed. When true, all three STRIPE_* vars are
# required and the server refuses to start without them. Stripe ids per environment (staging sandbox,
# production) and which values go on which Vercel environment: docs/billing.md.
BILLING_ENABLED=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Optional: another Stripe API host for local tests, e.g. http://localhost:12111 (stripe-mock).
STRIPE_API_BASE=
# Self-hosted testing only (VEC-240): with AIMPOINT_DEBUG=1 and BILLING_ENABLED unset, org admins get a
# Settings > Debug tab whose "Test billing" switch turns billing on for the whole instance without a redeploy
# (stored in MongoDB, instanceSettings). It needs the three STRIPE_* vars with a TEST-mode key (sk_test_/rk_test_);
# a live key is refused. A bad setup never stops startup: the Debug tab reports it. Switching it off (or unsetting
# AIMPOINT_DEBUG) returns every org to self-hosted (everything on); billing data is kept. Ignored when BILLING_ENABLED is set.
AIMPOINT_DEBUG=
# Webhook endpoint: POST /api/stripe/webhook (events: checkout.session.completed,
# customer.subscription.created/updated/deleted, invoice.payment_failed).
