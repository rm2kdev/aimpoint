# Required
AUTH_SECRET=
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=vector

# Real-time on Vercel (leave unset locally to use Server-Sent Events)
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# Image uploads on Vercel (set automatically when a Blob store is connected)
BLOB_READ_WRITE_TOKEN=

# Vercel Cron for /api/cron/wakes (push wake-up retries) and /api/cron/wait-reminders; unset = routes off. Not needed locally.
CRON_SECRET=

# Billing for managed hosting (Stripe, US$5/month per organisation). Unset or false = self-hosted:
# billing off, every feature unlocked, no Stripe needed. When true, all three STRIPE_* vars are
# required and the server refuses to start without them.
BILLING_ENABLED=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Optional: another Stripe API host for local tests, e.g. http://localhost:12111 (stripe-mock).
STRIPE_API_BASE=
# Webhook endpoint: POST /api/stripe/webhook (events: checkout.session.completed,
# customer.subscription.created/updated/deleted, invoice.payment_failed).
